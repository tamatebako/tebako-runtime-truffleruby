# Feedstock recipe for truffleruby
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "truffleruby"
kind: runtime
summary: "TruffleRuby (GraalVM Community, native mode) — tebako ruby RUNTIME pairs (wrapper exe + env image); the spec 28 §8 implementation axis's truffleruby flavor (ruby:truffleruby)"

# The flavor dimension (spec 28 §8's implementation axis shape — one
# recipe, flavored sources). For truffleruby the flavor key names the
# MODE: `native` (the exe-relative native-image launcher) and `jvm`
# (TODO.truffleruby/03 — the spec 33 runtime-on-runtime form, an owner
# edge to java:graalvm). The implementation value is `truffleruby` on
# BOTH modes — the mode is a NON-axis for selection (spec 33 §6: mode
# selection rides `;tebako=` or per-entry pins, never the selector
# grammar; the registry names the jvm entry `truffleruby-jvm`).
flavors:
  native:
    implementation: "truffleruby"
    language_version: "3.4"          # the ruby language line (34.0.1 reports "like ruby 3.4.9")
    abi_line: "34"                   # truffleruby's own line grammar (spec 28 §8's ABI line for native-ext payloads)
    interpreter_api_version: "3.4"   # layout.yaml's required declared line
    # The complete bin/ inventory of the staged home (spec 03 §2.2
    # completeness — verified against the staged macos tree 2026-09-06:
    # 15 names; ruby + truffleruby are real Mach-O/ELF launchers, the
    # rest are upstream's bash shims that self-locate via $0 and exec the
    # sibling ruby — path-agnostic, no shebang rewrite needed).
    entrypoints: [bundle, bundler, erb, gem, irb, racc, rake, rbs, rdbg, rdoc, ri, ruby, syntax_suggest, truffleruby, truffleruby-polyglot-get]
    upstream:
      # TruffleRuby Community 34.0.1 (oracle/truffleruby, tag
      # graal-34.0.1) — the NATIVE-mode archives (no JVM in the image).
      # Upstream publishes NO sha256 sums: the pins below were computed
      # from the downloaded archives 2026-09-06 and are the single trust
      # anchor (same standing as the recipe's link-unit pins).
      # Platform matrix: upstream ships NO windows build and no
      # macos-x86_64 build — the registry declares the three carried
      # triplets declaratively (never by omission).
      version: "34.0.1"
      tag: "graal-34.0.1"     # the upstream release tag (no build number upstream)
      sources:
        - platform: "aarch64-macos"
          url: "https://github.com/oracle/truffleruby/releases/download/graal-34.0.1/truffleruby-community-34.0.1-macos-aarch64.tar.gz"
          sha256: "cadd829d48ce71da927e4aca9b02dd3f18fb2ff1a33f197d22d855b3fc087600"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://github.com/oracle/truffleruby/releases/download/graal-34.0.1/truffleruby-community-34.0.1-linux-amd64.tar.gz"
          sha256: "d73540e36d457555d57c7bff7c35805d05388912fb54a880dea10cc44d001f41"
          strip_components: 1
        - platform: "aarch64-linux-gnu"
          url: "https://github.com/oracle/truffleruby/releases/download/graal-34.0.1/truffleruby-community-34.0.1-linux-aarch64.tar.gz"
          sha256: "8b1156eda10f3a00c56544f91c3f06735db49fe5850d801bb2760ab0b8315441"
          strip_components: 1

  # The JVM-mode flavor (TODO.truffleruby/03 — spec 33's runtime-on-runtime
  # form, the spec's FIRST feedstock instance): the env image is the
  # truffleruby JVM home (modules/ + the same 15-name bin/ inventory —
  # bin/ruby is a real Mach-O/ELF launcher in the JVM distribution too,
  # verified 2026-09-07), composed ON a graalvm java owner at dispatch.
  # Every contract fact below is the 2026-09-07 spec-33 dogfood's
  # (TODO.truffleruby/03's record; PROGRESS/35): the argv template
  # verbatim, the llvm/sulong home token, the -XX:-UseJVMCINativeLibrary
  # bridge (libgraal JNI-links ONLY on an exact owner-build match), the
  # whole-tree home annotation (the literal java_home key, tebako#548).
  jvm:
    implementation: "truffleruby"
    language_version: "3.4"          # the ruby language line (same upstream build as native)
    abi_line: "34"
    interpreter_api_version: "26"    # the dogfood-proven layout line (the jvm home declares NO interpreter — spec 33 §5)
    entrypoints: [bundle, bundler, erb, gem, irb, racc, rake, rbs, rdbg, rdoc, ri, ruby, syntax_suggest, truffleruby, truffleruby-polyglot-get]
    # The owner edge (spec 33 §2): graalvm-flavor java ONLY — a temurin
    # owner must produce the named error, never a slow silent run
    # (bench-2a 2026-09-07: interpreted JVM mode = fib34 ~5.2x SLOWER
    # than MRI; silence would ship that).
    on_runtime:
      engine: "java"
      implementation: "graalvm"
      constraint: ">= 24"
      mount: "/__runners__/truffleruby"
    # The compose template, dogfood-verbatim (all tokens space-free).
    # {mount} splices the materialized whole-tree home root per spec 33
    # §2's bridge law.
    argv_template: ["-XX:-UseJVMCINativeLibrary", "-Dorg.graalvm.language.ruby.home={mount}", "-Dorg.graalvm.language.llvm.home={mount}/lib/sulong", "--module-path", "{mount}/modules", "-m", "dev.truffleruby.launcher/org.truffleruby.launcher.RubyLauncher"]
    # The jvm pair REQUIRES the spec-33-aware launcher — tebako >= 2.5.0
    # (the shared runtime.wrapper_tebako stays the native flavor's 2.8.21
    # line; the mode rides the tebako line per spec 28 §8, so the two
    # flavors coexist in one store: ruby-34.0.1-2.8.21 vs -2.8.22).
    # Digests are the v2.8.22 release's SHA256SUMS entries, fetched
    # 2026-09-28.
    wrapper_tebako: "2.8.66"
    wrapper_sha256:
      macos-arm64: "2bcc86e044c218272fc83638aaf80519ac212a52358db80487ea05ad2e8fdd85"
      linux-gnu-x86_64: "443be3b952dfd12ee83d67cc2298376e017aafa4968be2ed8ffd215d687ea0df"
      linux-gnu-arm64: "68ad68e692ac268e80c9632f32d39ed770d8000f55e5824db205200cbfa3d4c0"
    # The owner pair the composed smoke runs against (the jvm legs
    # download it into a throwaway store): the published java:graalvm
    # line — tamatebako/tebako-runtime-openjdk v2.8.21, graalvm CE 25.0.4.1 on the
    # tebako 2.8.21 line. Digests are that release's per-asset .sha256
    # sidecar entries (cross-checked at fetch; the owner exe IS the
    # line's tebako-runtime-launcher bytes — same sums as the 2.8.21
    # wrapper pins below, by construction). NOTE: this block sits AFTER upstream
    # on purpose — tools/build's indentation-anchored reader takes the
    # first 6-space `version:`/`tag:` in the flavor, which must be the
    # UPSTREAM's (the 2026-09-07 local gate caught owner_smoke.version
    # shadowing it: artifacts came out named ...-25.0.4.1-...).
    upstream:
      # Same upstream release as native (graal-34.0.1) — the JVM-mode
      # archives. Upstream publishes NO sha256 sums: the pins below were
      # computed from the downloaded archives 2026-09-07 and are the
      # single trust anchor.
      # Platform matrix: the graalvm OWNER's coverage is the constraint —
      # openjdk-graalvm 25.0.4.1 ships macos-arm64 + linux-gnu-x86_64
      # (+ windows-ucrt64, which truffleruby upstream does not cover).
      # aarch64-linux-gnu lands when the graalvm flavor gains that leg —
      # a named follow-up, never a silent omission (the linux-aarch64
      # archive's computed sha256 for that day:
      # c5b56f62a3238b98bab2fd2b624e16bc907b0f4f888b196950748739c5ce4790).
      version: "34.0.1"
      tag: "graal-34.0.1"
      sources:
        - platform: "aarch64-macos"
          url: "https://github.com/oracle/truffleruby/releases/download/graal-34.0.1/truffleruby-community-jvm-34.0.1-macos-aarch64.tar.gz"
          sha256: "c1ca478c7534f4b1f317d11ac95b273757bbf273f6de533887f4a6129e588ab2"
          strip_components: 1
        - platform: "x86_64-linux-gnu"
          url: "https://github.com/oracle/truffleruby/releases/download/graal-34.0.1/truffleruby-community-jvm-34.0.1-linux-amd64.tar.gz"
          sha256: "62d65585fbff7c2b26398c397d0d2ea1b5fb4c7760c1dfe04c7dce966e6c9d15"
          strip_components: 1
    owner_smoke:
      repo: "tamatebako/tebako-runtime-openjdk"
      release: "v2.8.47"
      version: "25.0.4.1"
      # The owner line MUST be >= 2.5.0 — the spec-33 entry-routing rule
      # (the entry resolves past the dep mount) lives in that launcher; a
      # 2.4.0 owner joins the entry onto the dep mount (the 2026-09-07
      # local gate; tebako#552). v2.8.21 additionally shares the 64 MiB
      # limnifs inline-metadata ceiling with this repo's v2.8.21 imager —
      # the owner mounts this runtime's image through its own driver, so
      # the caps must match. The exe digests equal the 2.8.21
      # launcher's monolith entries (the pair's exe IS the launcher,
      # byte-identical); the image digests are the openjdk v2.8.21
      # release's .tfs.sha256 sidecar entries.
      # tebako#716: the fetched owner pair's ASSET name follows the
      # pinned owner release's own era. v2.8.21's assets are the
      # segment-less spelling, so this block carries NO `implementation`
      # key; the bump to a post-#716 owner release adds
      # `implementation: graalvm` here, and tools/pins.rb's OWNER_STEM
      # composes the segmented name from it.
      tebako: "2.8.47"
      implementation: "graalvm"
      exe_sha256:
        macos-arm64: "eeee3f7bff1f7b8bd3b17e624ab5856c4fb5d8edb446f79ab962b44bd5651704"
        linux-gnu-x86_64: "7829d1a1f221aeca7bd79be40ebf3999563cbcff436f961b40bc08772ff06d1b"
      image_sha256:
        macos-arm64: "d6f62fad0853c3a30828d5ba2181bd134cf8b76fbceacc42bb17f4ac12c8605b"
        linux-gnu-x86_64: "9a78cf9ca6ffb90c54426f0d616a2feeea98d011d51754a27a3193b60cfc77d8"

runtime:
  engine: "ruby"
  contract_version: 2              # the spec 17 driver contract the wrapper speaks
  interpreter: "/bin/ruby"         # the wrapper's interpreter grant (layout schema_minor 4)
  smoke_args: "-v"                 # the interpreter's version flag (the build's boot smokes)
  # The per-flavor entrypoints list (flavors:<flavor>.entrypoints) is the
  # feedstock SSOT for the spawn surface (spec 30 §2): tools/build renders
  # it into the env image manifest's runtime entrypoints, the driver's
  # bare-name --tebako-entry resolves against exactly these declarations,
  # and the read-back + smoke gates prove them.
  #
  # spec 29 §3, settled EMPIRICALLY 2026-09-06 (the due-diligence probe,
  # PR body): the truffleruby native launcher resolves its home
  # EXE-RELATIVE and nothing else — an isolated bin/ruby dies
  # ("Loading libjli failed", rc 255) and NEITHER -Xhome/--home NOR
  # TRUFFLERUBY_HOME overrides it. visibility preload (tier 1)
  # materializes the exe alone, so self-location can never find the
  # home; exec-cache (tier 2b) materializes the home whole (the
  # java_home-annotated mount), and the exe-relative resolution then
  # lands inside the materialized tree by construction. A JVM needs no
  # VFS once its home is materialized — the same holds for this
  # native-image launcher.
  visibility: "exec-cache"
  mount_root_override: false       # closed default — under exec-cache the interpreter reads the materialized tree, never the mount; granting a no-op knob violates spec 00 §9
  # The tebako product line the pair builds against: the wrapper exe
  # (tebako-runtime-launcher) and the preload shim (link-unit). The line
  # number names the artifacts (tebako-runtime-<line>-truffleruby-34.0.1-*
  # — tebako#716's language segment is the flavor's implementation) and
  # the release tag (v<line> — the trr convention: the tag IS the tebako
  # line). v2.8.21 is the NATIVE flavor's line (the limnifs era: the
  # launcher's 64 MiB inline-metadata ceiling + the shard-era registry
  # grammar; spec 32's kind:executable reader is REQUIRED downstream of
  # this runtime — see the openjdk recipe's pin-comment history); the
  # jvm flavor overrides per-flavor
  # (flavors.jvm.wrapper_tebako 2.5.0 — the spec-33-aware launcher).
  # v2.8.55: the published native flavor's line takes the transport
  # window (tebako#851) and the host gate (tebako#853). The jvm flavor
  # KEEPS its 2.8.22 override deliberately — the store entry name
  # carries the tebako line, so two flavors on one line would collide in
  # a single store; the split is what makes them coexist.
  wrapper_tebako: "2.8.66"
  # The wrapper's trust anchor, per tool-platform (the launcher is the
  # shipped runtime pair's process entry point — an unauthenticated
  # download would be a supply-chain hole). Digests are the v2.8.49
  # release's own asset digests, fetched 2026-10-21 (v2.8.47 → v2.8.49
  # carries the tebako#831 entry bridge + the tebako#839 .drectve
  # NUL-delimiter).
  wrapper_sha256:
    macos-arm64: "2bcc86e044c218272fc83638aaf80519ac212a52358db80487ea05ad2e8fdd85"
    linux-gnu-x86_64: "443be3b952dfd12ee83d67cc2298376e017aafa4968be2ed8ffd215d687ea0df"
    linux-gnu-arm64: "68ad68e692ac268e80c9632f32d39ed770d8000f55e5824db205200cbfa3d4c0"

# Factory tools used by tools/build (the imager + the preload shim): the
# tfs CLI and the link-unit tarball from the tamatebako/tebako release.
# The asset digests are pinned HERE — tools.sha256 is the repo's
# toolchain pin SSOT (the workflow carries no version or digest literals;
# tools/pins.rb reads this block into $GITHUB_ENV). The tfs pins are
# cross-checked against the release's SHA256SUMS at fetch time; the
# link-unit tarballs are NOT in that monolith, so these pins are their
# single trust anchor (computed from the v2.5.0 downloads 2026-09-07).
# v2.5.0 is REQUIRED for the jvm flavor: tfs mkimage re-serializes the
# embedded manifest THROUGH the tpkg model, and only the 2.5.0 model
# round-trips on_runtime + the widened requires grammar (spec 33); the
# 2.4.0 CLI would silently strip the owner edge. The native flavor builds
# with the same 2.5.0 tools — the model is a strict superset.
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.66"
  sha256:
    tfs:
      macos-arm64: "eef0a61bdc656f5ded7b3186a1660ca8798958cbb9e44d7132dd851f7e877aaf"
      linux-gnu-x86_64: "3a296bcb61259ebcb4232515c7f56b9578b331dd94610a3985443069d42f365a"
      linux-gnu-arm64: "601afb8922e8ca520e646bbb1b8ed124e5d32fe0b2604b202a2a8b62de7ddba0"
    link-unit:                       # all legs are POSIX (upstream ships no windows build)
      macos-arm64: "03e167ce85330e074207844c0d02703d71ba0381484c5ff9f521d4cb122bb097"
      linux-gnu-x86_64: "67edc85ab8f7cbf5ab3f031b03ba97628d4ad531245686d415aac4adcc2dfad5"
      linux-gnu-arm64: "2e7cf4b35489491e3317c6f39ee33264e65d5524d833a969dbcb3d744d1304c0"
    # The dispatcher for the jvm legs' COMPOSED smoke (spec 33's real
    # wire: shim → dep runtime → owner runtime). Pinned for all three
    # tool platforms so the native legs' pins.rb run stays total; only
    # the jvm legs' smoke fetches it. Digests are the pinned line's own
    # SHA256SUMS entries (cross-checked at fetch like the tfs pin).
    tebako-shim:
      macos-arm64: "1a300785ec9688837ee9562e4b878ac224065e2989c04b82a207a93146e551d8"
      linux-gnu-x86_64: "97b0d8f448d129f62caf3aa6be2ecd64fa945cbc8560c4bc15a07d6bfcdf4983"
      linux-gnu-arm64: "2b96e14ca11d9edba59c704a566cad95e8903b02932848f548f73647718e4861"

image:
  format: limnifs
  # .tfs everywhere (the tebako fs image — LimniFS, the default format;
  # the store extension stays .tfs regardless of format)
  extension:
    default: tfs
